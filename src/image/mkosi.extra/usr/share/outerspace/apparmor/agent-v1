#include <tunables/global>

profile outerspace-agent-v1 flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # Read the workload image; execute its tools without changing confinement.
  /** r,
  /{,usr/,usr/local/}{bin,sbin}/** rix,
  /{lib,lib64,usr/lib,usr/lib64}/** mr,
  /workspace/ rw,
  /workspace/** rwk,
  /scratch/ rw,
  /scratch/** rwk,
  /dev/null rw,
  /dev/{zero,random,urandom} r,

  # Network authorization is owned by the namespace's default-deny policy.
  network inet stream,
  network inet6 stream,
  network unix stream,
  signal (send,receive) peer=outerspace-agent-v1,
  signal (receive) peer=unconfined,
  # Ubuntu names its otherwise unconfined OCI runtime "runc". Permit the
  # trusted runtime to stop/reap workloads, including forced SIGKILL teardown.
  signal (receive) peer=runc,

  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace,
  deny /proc/sys/** r,
  deny /proc/{kcore,keys,timer_list,sched_debug} r,
  deny /proc/*/mem rw,
  deny /sys/firmware/** r,
  deny /{,var/}run/{containerd,docker,crio}/** rwklx,
}
