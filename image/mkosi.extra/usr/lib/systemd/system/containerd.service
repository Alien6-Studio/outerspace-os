[Unit]
Description=OuterSpace container runtime
After=network.target local-fs.target outerspace-provision.service dfdaemon.service
Wants=network.target dfdaemon.service
RequiresMountsFor=/var/lib/containerd

[Service]
Type=notify
ExecStartPre=/usr/sbin/modprobe overlay
ExecStart=/usr/bin/containerd --config /etc/containerd/config.toml
Restart=always
RestartSec=5
Delegate=yes
KillMode=process
OOMScoreAdjust=-999
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=0
TasksMax=infinity

[Install]
WantedBy=multi-user.target
