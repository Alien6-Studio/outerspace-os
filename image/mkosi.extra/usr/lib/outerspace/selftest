set -euo pipefail
fail() { echo "OUTERSPACE_SELFTEST_FAIL: $*"; exit 1; }
[[ $(stat -fc %T /sys/fs/cgroup) == cgroup2fs ]] || fail 'cgroup v2 missing'
[[ $(stat -fc %T /sys/fs/bpf) == bpf_fs ]] || fail 'bpffs missing'
[[ -s /sys/kernel/btf/vmlinux ]] || fail 'kernel BTF missing'
findmnt -n -o OPTIONS / | tr ',' '\n' | grep -qx ro || fail 'root is writable'
[[ $(findmnt -n -o FSTYPE /) == ext4 ]] || fail 'unexpected root filesystem'
ls /sys/block/dm-*/dm/name | xargs cat | grep -q root || fail 'verity mapping missing'
touch /var/lib/outerspace/state-write-test
[[ $(sysctl -n kernel.kptr_restrict) == 2 ]] || fail 'hardening sysctls absent'
[[ $(sysctl -n kernel.unprivileged_bpf_disabled) != 0 ]] || fail 'unprivileged BPF allowed'
[[ $(sysctl -n net.ipv4.ip_forward) == 1 ]] || fail 'forwarding disabled'
[[ $(cat /sys/module/apparmor/parameters/enabled) == Y ]] || fail 'AppArmor disabled'
[[ $(id -u outerspace) == 1000 ]] || fail 'operator account missing'
[[ $(stat -c %a /var/home/outerspace) == 700 ]] || fail 'operator home permissions'
[[ $(getent shadow outerspace | cut -d: -f2) == '!'* ]] || fail 'operator password unlocked'
systemctl is-active --quiet containerd || fail 'containerd inactive'
/usr/bin/crictl info >/run/outerspace-cri-info.json || fail 'CRI not serving'
/usr/bin/containerd --version
/usr/bin/kubelet --version
free -m
df -h / /var
echo OUTERSPACE_SELFTEST_OK
