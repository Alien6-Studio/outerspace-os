[
  "qemu-system-aarch64",
  "-machine",
  "virt",
  "-cpu",
  "max",
  "-accel",
  "tcg",
  "-m",
  "4096",
  "-smp",
  "4",
  "-nographic",
  "-no-reboot",
  "-uuid",
  "c9edd8d8-1e37-4040-816a-cc60c1ed8b7e",
  "-boot",
  "order=c,strict=on",
  "-drive",
  "if=pflash,format=raw,readonly=on,file=/usr/share/AAVMF/AAVMF_CODE.fd",
  "-drive",
  "if=pflash,format=raw,file=/state/vars.fd",
  "-drive",
  "if=virtio,format=qcow2,file=/state/disk.qcow2",
  "-netdev",
  "tap,id=net0,ifname=tap0,script=no,downscript=no",
  "-device",
  "virtio-net-pci,netdev=net0,mac=52:54:00:80:00:10",
  "-smbios",
  "type=11,value=io.systemd.stub.kernel-cmdline-extra=systemd.journald.forward_to_console=1",
  "-qmp",
  "unix:/state/qmp.sock,server=on,wait=off",
  "-pidfile",
  "/state/qemu.pid",
  "-drive",
  "if=virtio,format=raw,readonly=on,file=/state/node-config.raw"
]
