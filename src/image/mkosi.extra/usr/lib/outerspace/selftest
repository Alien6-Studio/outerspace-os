set -euo pipefail
trap 'echo "OUTERSPACE_SELFTEST_FAIL: command failed at line $LINENO" >&2' ERR
fail() { echo "OUTERSPACE_SELFTEST_FAIL: $*"; exit 1; }
. /usr/lib/os-release
[[ "$OUTERSPACE_PROFILE" == agent || "$OUTERSPACE_PROFILE" == inference ]] || fail 'invalid image profile'
[[ "$OUTERSPACE_SOURCE_COMMIT" =~ ^[a-f0-9]{40}$ ]] || fail 'invalid source identity'
printf 'OUTERSPACE_IMAGE_IDENTITY profile=%s hardware=%s architecture=%s commit=%s\n' \
    "$OUTERSPACE_PROFILE" "$OUTERSPACE_HARDWARE_PROFILE" "$OUTERSPACE_ARCHITECTURE" "$OUTERSPACE_SOURCE_COMMIT"
[[ $(stat -fc %T /sys/fs/cgroup) == cgroup2fs ]] || fail 'cgroup v2 missing'
[[ $(stat -fc %T /sys/fs/bpf) == bpf_fs ]] || fail 'bpffs missing'
[[ -s /sys/kernel/btf/vmlinux ]] || fail 'kernel BTF missing'
# Cilium opens ROUTE, XFRM and NETFILTER handles even without IPsec encryption.
# Check the actual sockets before a full enrollment lab can reach the same error.
ip xfrm policy >/dev/null || fail 'XFRM netlink interface missing'
for family in -4 -6; do
    ip "$family" rule show >/run/outerspace-routing-rules || fail 'policy routing interface missing'
    grep -q 'lookup local' /run/outerspace-routing-rules || fail 'local routing rule missing'
done
ss -H -u -a >/dev/null 2>/run/outerspace-udp-diag.err || fail 'UDP socket diagnostics missing'
[[ ! -s /run/outerspace-udp-diag.err ]] || fail 'UDP socket diagnostics fell back or reported an error'
[[ -r /proc/schedstat ]] || fail 'scheduler statistics missing'
findmnt -n -o OPTIONS / | tr ',' '\n' | grep -qx ro || fail 'root is writable'
[[ $(findmnt -n -o FSTYPE /) == ext4 ]] || fail 'unexpected root filesystem'
ls /sys/block/dm-*/dm/name | xargs cat | grep -q root || fail 'verity mapping missing'
touch /var/lib/outerspace/state-write-test
[[ $(sysctl -n kernel.kptr_restrict) == 2 ]] || fail 'hardening sysctls absent'
[[ $(sysctl -n kernel.unprivileged_bpf_disabled) != 0 ]] || fail 'unprivileged BPF allowed'
[[ $(sysctl -n net.ipv4.ip_forward) == 1 ]] || fail 'forwarding disabled'
[[ $(cat /sys/module/apparmor/parameters/enabled) == Y ]] || fail 'AppArmor disabled'
if [[ "$OUTERSPACE_PROFILE" == agent ]]; then
    [[ -s /run/outerspace/agent-blockio.json ]] || fail 'Agent I/O policy missing'
    grep -qw io /sys/fs/cgroup/cgroup.controllers || fail 'Agent I/O controller missing'
    systemctl is-active --quiet outerspace-agent-profile || fail 'Agent AppArmor policy not loaded'
    grep -qx 'outerspace-agent-v1 (enforce)' /sys/kernel/security/apparmor/profiles || fail 'Agent AppArmor policy not enforcing'
    abi=/sys/kernel/security/apparmor/features/policy/versions
    grep -qx yes "$abi/v7" || fail 'AppArmor policy ABI v7 unavailable'
    for version in "$abi"/*; do
        printf 'OUTERSPACE_APPARMOR_ABI %s=%s\n' "${version##*/}" "$(cat "$version")"
    done
fi
[[ $(id -u outerspace) == 1000 ]] || fail 'operator account missing'
[[ $(stat -c %a /var/home/outerspace) == 700 ]] || fail 'operator home permissions'
[[ $(getent shadow outerspace | cut -d: -f2) == '!'* ]] || fail 'operator password unlocked'
systemctl is-active --quiet containerd || fail 'containerd inactive'
/usr/bin/crictl info >/run/outerspace-cri-info.json || fail 'CRI not serving'
/usr/bin/containerd --version
/usr/bin/kubelet --version
if [[ ! -e /dev/disk/by-label/OOS_CONFIG && ! -e /var/lib/kubelet/kubeconfig ]]; then
    systemctl is-failed --quiet outerspace-provision || fail 'missing enrollment configuration was silently accepted'
    journalctl -b -u outerspace-provision --no-pager | grep -q OUTERSPACE_ENROLLMENT_CONFIG_INVALID || fail 'missing enrollment diagnostic'
    ! systemctl is-active --quiet kubelet || fail 'unconfigured kubelet started'
    echo OUTERSPACE_ENROLLMENT_UNCONFIGURED_OK
fi
free -m
df -h / /var
phase=
nonce=
idle_host=false
for option in $(cat /proc/cmdline); do
    case "$option" in
        outerspace.selftest.phase=*) phase=${option#*=} ;;
        outerspace.selftest.nonce=*) nonce=${option#*=} ;;
        outerspace.selftest.baseline=1) idle_host=true ;;
    esac
done
if [[ -n "$phase" ]]; then
    [[ -d /sys/firmware/efi ]] || fail 'not booted through UEFI'
    efi=/sys/firmware/efi/efivars
    vendor=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
    [[ -f "$efi/LoaderInfo-$vendor" && -f "$efi/StubInfo-$vendor" ]] || fail 'EFI loader/stub evidence missing'
    # efivarfs does not support seeking; copy to a pipe before removing attributes.
    loader=$(cat "$efi/LoaderInfo-$vendor" | tail -c +5 | tr -d '\000')
    stub=$(cat "$efi/StubInfo-$vendor" | tail -c +5 | tr -d '\000')
    [[ "$loader" == 'systemd-boot '* && "$stub" == 'systemd-stub '* ]] || fail 'unexpected EFI loader/stub'
    printf 'OUTERSPACE_UEFI_OK: %s -> %s\n' "$loader" "$stub"
    [[ "$nonce" =~ ^[a-f0-9]{32}$ ]] || fail 'invalid persistence nonce'
    state=/var/lib/outerspace/selftest-persistence
    case "$phase" in
        prepare)
            [[ ! -e "$state" ]] || fail 'persistence test state is not fresh'
            (umask 077; printf '%s\n' "$nonce" "$(hostname)" "$(cat /etc/machine-id)" "$(cat /proc/sys/kernel/random/boot_id)" > "$state")
            sync -f "$state"
            echo OUTERSPACE_PERSISTENCE_PREPARE_OK
            ;;
        verify)
            [[ -f "$state" && ! -L "$state" ]] || fail 'state did not survive poweroff'
            mapfile -t prior < "$state"
            [[ ${#prior[@]} == 4 && "${prior[0]}" == "$nonce" ]] || fail 'wrong persisted test identity'
            [[ "${prior[1]}" == "$(hostname)" ]] || fail 'hostname changed after poweroff'
            [[ "${prior[2]}" == "$(cat /etc/machine-id)" ]] || fail 'machine-id changed after poweroff'
            [[ "${prior[3]}" != "$(cat /proc/sys/kernel/random/boot_id)" ]] || fail 'second boot was not a new kernel boot'
            echo OUTERSPACE_PERSISTENCE_VERIFY_OK
            ;;
        *) fail 'invalid persistence test phase' ;;
    esac
fi
if "$idle_host"; then
    # Only this opt-in, short-lived observer runs; no enrollment or workload.
    idle_state() {
        [[ ! -e /dev/disk/by-label/OOS_CONFIG && ! -e /var/lib/kubelet/kubeconfig ]] || fail 'idle host is configured'
        ! systemctl is-active --quiet kubelet || fail 'idle kubelet is running'
        ! systemctl is-active --quiet dfdaemon || fail 'idle P2P peer is running'
        local pods containers
        pods=$(/usr/bin/crictl pods -q) || fail 'cannot inspect idle sandboxes'
        containers=$(/usr/bin/crictl ps -a -q) || fail 'cannot inspect idle containers'
        [[ -z "$pods" && -z "$containers" ]] || fail 'idle host contains workloads'
    }
    idle_sample() {
        local uptime unused key value unit separator= service group usage memory anon file kernel
        local -a ticks filesystem
        read -r uptime unused </proc/uptime
        read -ra ticks </proc/stat
        printf '{"uptime_seconds":%s,"cpu_ticks":[' "$uptime"
        for value in "${ticks[@]:1}"; do printf '%s%s' "$separator" "$value"; separator=,; done
        printf '],"memory_bytes":{'
        separator=
        while read -r key value unit; do
            case "$key" in
                MemTotal:|MemAvailable:|Buffers:|Cached:|AnonPages:|Slab:|SReclaimable:|KernelStack:|PageTables:|Unevictable:)
                    [[ "$unit" == kB && "$value" =~ ^[0-9]+$ ]] || fail 'invalid memory observation'
                    printf '%s"%s":%s' "$separator" "${key%:}" "$((value * 1024))"; separator=, ;;
            esac
        done </proc/meminfo
        printf '},"filesystems":{'
        separator=
        for group in / /var; do
            read -ra filesystem <<<"$(stat -f -c '%S %b %f %a' "$group")"
            [[ ${#filesystem[@]} == 4 ]] || fail 'missing filesystem observation'
            printf '%s"%s":{"capacity_bytes":%s,"used_bytes":%s,"available_bytes":%s}' \
                "$separator" "$group" "$((filesystem[0] * filesystem[1]))" \
                "$((filesystem[0] * (filesystem[1] - filesystem[2])))" "$((filesystem[0] * filesystem[3]))"
            separator=,
        done
        printf '},"services":{'
        separator=
        for service in containerd systemd-journald systemd-networkd systemd-resolved outerspace-selftest; do
            group=/sys/fs/cgroup/system.slice/$service.service
            printf '%s"%s":' "$separator" "$service"
            if [[ -d "$group" ]]; then
                memory=$(<"$group/memory.current")
                usage=
                while read -r key value; do [[ "$key" != usage_usec ]] || usage=$value; done <"$group/cpu.stat"
                anon= file= kernel=
                while read -r key value; do
                    case "$key" in anon) anon=$value ;; file) file=$value ;; kernel) kernel=$value ;; esac
                done <"$group/memory.stat"
                for value in "$memory" "$usage" "$anon" "$file" "$kernel"; do
                    [[ "$value" =~ ^[0-9]+$ ]] || fail 'missing service accounting'
                done
                printf '{"memory_current_bytes":%s,"memory_anon_bytes":%s,"memory_file_bytes":%s,"memory_kernel_bytes":%s,"cpu_usage_usec":%s}' \
                    "$memory" "$anon" "$file" "$kernel" "$usage"
            else
                printf null
            fi
            separator=,
        done
        printf '}}'
    }
    [[ "$phase" == prepare || "$phase" == verify ]] || fail 'idle baseline requires UEFI persistence phase'
    idle_state
    read -r settle_started unused </proc/uptime
    sleep 60
    samples=("$(idle_sample)")
    for interval in 1 2 3; do sleep 10; samples+=("$(idle_sample)"); done
    idle_state
    host=$(hostname)
    machine_id=$(cat /etc/machine-id)
    boot_id=$(cat /proc/sys/kernel/random/boot_id)
    [[ "$host" =~ ^[A-Za-z0-9.-]+$ && "$machine_id" =~ ^[a-f0-9]{32}$ && "$boot_id" =~ ^[a-f0-9-]{36}$ ]] || fail 'invalid idle identity'
    printf 'OUTERSPACE_IDLE_HOST {"schema":1,"phase":"%s","nonce":"%s","profile":"%s","hardware_profile":"%s","architecture":"%s","commit":"%s","hostname":"%s","machine_id":"%s","boot_id":"%s","vcpus":%s,"clock_ticks_per_second":%s,"settle_started_uptime_seconds":%s,"settle_seconds":60,"interval_seconds":10,"sandboxes":0,"containers":0,"kubelet_active":false,"p2p_active":false,"samples":[' \
        "$phase" "$nonce" "$OUTERSPACE_PROFILE" "$OUTERSPACE_HARDWARE_PROFILE" "$OUTERSPACE_ARCHITECTURE" "$OUTERSPACE_SOURCE_COMMIT" \
        "$host" "$machine_id" "$boot_id" "$(getconf _NPROCESSORS_ONLN)" "$(getconf CLK_TCK)" "$settle_started"
    separator=
    for sample in "${samples[@]}"; do printf '%s%s' "$separator" "$sample"; separator=,; done
    printf ']}\n'
fi
echo OUTERSPACE_SELFTEST_OK
